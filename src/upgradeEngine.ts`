/**
 * Purchases an upgrade and updates the campaign state.
 */
export function purchaseUpgrade(state: CampaignState, upgradeId: string): { newState: CampaignState; success: boolean; message: string } {
  const upgrade = UPGRADE_DATABASE.find(u => u.id === upgradeId);
  if (!upgrade) return { newState: state, success: false, message: "Upgrade not found." };

  const purchased = state.purchasedUpgrades || [];
  if (purchased.includes(upgradeId)) return { newState: state, success: false, message: "Upgrade already purchased." };

  if (state.funds < upgrade.cost) return { newState: state, success: false, message: "Insufficient funds." };

  if (upgrade.requirement && !upgrade.requirement(state)) {
    return { newState: state, success: false, message: "Requirements for this upgrade are not met." };
  }

  return {
    newState: {
      ...state,
      funds: state.funds - upgrade.cost,
      purchasedUpgrades: [...purchased, upgradeId],
    },
    success: true,
    message: `Upgrade "${upgrade.title}" purchased successfully!`,
  };
}

/**
 * Helper to check if a specific upgrade is active.
 */
export function hasUpgrade(state: CampaignState, upgradeId: string): boolean {
  return (state.purchasedUpgrades || []).includes(upgradeId);
}
