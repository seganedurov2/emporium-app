import React from 'react';
import { X, AlertTriangle, TrendingUp, ShieldAlert, Globe, Zap } from 'lucide-react';
import type { GameEvent, EventChoice } from '../../eventsEngine';
import { formatMoney } from '../../currency';

interface EventModalProps {
  event: GameEvent;
  onChoice: (choice: EventChoice) => void;
  onClose: () => void;
}

const CATEGORY_STYLES: Record<string, { color: string; icon: React.ElementType; label: string }> = {
  economy: { color: 'text-emerald-400', icon: TrendingUp, label: 'Экономика' },
  security: { color: 'text-rose-400', icon: ShieldAlert, label: 'Безопасность' },
  diplomacy: { color: 'text-sky-400', icon: Globe, label: 'Дипломатия' },
  opportunity: { color: 'text-amber-400', icon: Zap, label: 'Возможность' },
  crisis: { color: 'text-red-500', icon: AlertTriangle, label: 'Кризис' },
};

export function EventModal({ event, onChoice, onClose }: EventModalProps) {
  const style = CATEGORY_STYLES[event.category] || CATEGORY_STYLES.economy;
  const Icon = style.icon;

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm p-4">
      <article className="relative w-full max-w-lg overflow-hidden rounded-2xl border border-slate-700 bg-slate-900 shadow-2xl animate-in fade-in zoom-in duration-200">
        {/* Header */}
        <div className={`relative h-2 bg-gradient-to-r from-transparent via-current to-transparent ${style.color}`} />
        <div className="p-6">
          <div className="flex items-start justify-between gap-4">
            <div className="flex items-center gap-3">
              <div className={`rounded-lg p-2 bg-slate-800 ${style.color}`}>
                <Icon aria-hidden="true" className="h-6 w-6" />
              </div>
              <div>
                <span className={`text-[10px] font-bold uppercase tracking-wider ${style.color}`}>
                  {style.label}
                </span>
                <h2 className="text-xl font-bold text-white">{event.title}</h2>
              </div>
            </div>
            <button onClick={onClose} className="rounded-full p-1 text-slate-500 transition hover:text-white">
              <X aria-hidden="true" className="h-5 w-5" />
            </button>
          </div>

          <p className="mt-4 text-sm leading-relaxed text-slate-300">
            {event.description}
          </p>

          <div className="mt-8 space-y-3">
            {event.choices.map((choice, index) => (
              <button
                key={index}
                onClick={() => onChoice(choice)}
                className="group relative flex w-full items-center justify-between gap-3 rounded-xl border border-slate-700 bg-slate-800/50 p-3 text-left transition hover:border-amber-500/50 hover:bg-slate-800"
              >
                <span className="text-sm font-medium text-slate-200 group-hover:text-white">
                  {choice.text}
                </span>
                <div className="flex items-center gap-3 text-[11px] font-mono">
                  {choice.fundsDelta && (
                    <span className={choice.fundsDelta > 0 ? 'text-emerald-400' : 'text-rose-400'}>
                      {choice.fundsDelta > 0 ? '+' : ''}{formatMoney(choice.fundsDelta)}
                    </span>
                  )}
                  {choice.reputationDelta && (
                    <span className={choice.reputationDelta > 0 ? 'text-emerald-400' : 'text-rose-400'}>
                      {choice.reputationDelta > 0 ? '+' : ''}{choice.reputationDelta} реп.
                    </span>
                  )}
                </div>
              </button>
            ))}
          </div>
        </div>
      </article>
    </div>
  );
}
